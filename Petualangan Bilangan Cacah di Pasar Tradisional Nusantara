    <script>
        // ---------------------------------------------------------
        // 1. SISTEM AUDIO TERKALIBRASI (Revisi Poin 13)
        // Menggunakan Web Audio / Tone.js + SpeechSynthesis dengan fallback nada & visual highlight
        // ---------------------------------------------------------
        function playClickSound() {
            try {
                if (typeof Tone !== 'undefined') {
                    const synth = new Tone.Synth().toDestination();
                    synth.triggerAttackRelease("C5", "32n");
                }
            } catch (e) {}
        }

        function playSuccessSound() {
            try {
                if (typeof Tone !== 'undefined') {
                    const synth = new Tone.PolySynth().toDestination();
                    synth.triggerAttackRelease(["C5", "E5", "G5"], "16n");
                }
            } catch (e) {}
        }

        function playErrorSound() {
            try {
                if (typeof Tone !== 'undefined') {
                    const synth = new Tone.Synth().toDestination();
                    synth.triggerAttackRelease("G3", "16n");
                }
            } catch (e) {}
        }

        // Fungsi pelafalan bilangan dengan pemenggalan suku kata + indikator visual
        function speakNumber(numberValue, textLabel, btnElement) {
            // Efek nada pembuka agar siswa tahu audio aktif meski di perangkat tanpa paket suara TTS
            try {
                if (typeof Tone !== 'undefined') {
                    Tone.start();
                    const synth = new Tone.Synth().toDestination();
                    synth.triggerAttackRelease("E5", "16n");
                }
            } catch (e) {}

            // Animasi visual tombol sedang berbunyi
            if (btnElement) {
                const origText = btnElement.innerHTML;
                btnElement.innerHTML = "🔊 Melafalkan...";
                btnElement.classList.add("ring-4", "ring-amber-300");
                setTimeout(() => {
                    btnElement.innerHTML = origText;
                    btnElement.classList.remove("ring-4", "ring-amber-300");
                }, 2200);
            }

            // Coba gunakan speechSynthesis bahasa Indonesia jika tersedia
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(textLabel);
                utterance.lang = 'id-ID';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // ---------------------------------------------------------
        // 2. HELPER FORMAT RUPIAH & TERBILANG
        // ---------------------------------------------------------
        function formatRupiah(angka) {
            return 'Rp' + angka.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        function terbilang(n) {
            if (n === 0) return "Nol rupiah";
            const satuan = ["", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh", "delapan", "sembilan", "sepuluh", "sebelas"];
            function konversi(x) {
                if (x < 12) return satuan[x];
                if (x < 20) return konversi(x - 10) + " belas";
                if (x < 100) return konversi(Math.floor(x / 10)) + " puluh " + konversi(x % 10);
                if (x < 200) return "seratus " + konversi(x - 100);
                if (x < 1000) return konversi(Math.floor(x / 100)) + " ratus " + konversi(x % 100);
                if (x < 2000) return "seribu " + konversi(x - 1000);
                if (x < 1000000) return konversi(Math.floor(x / 1000)) + " ribu " + konversi(x % 1000);
                return "";
            }
            let hasil = konversi(n).replace(/\s+/g, ' ').trim();
            return hasil.charAt(0).toUpperCase() + hasil.slice(1) + " rupiah";
        }

        // ---------------------------------------------------------
        // 3. NOTIFIKASI TOAST (Pengganti alert() - Revisi Poin 1)
        // ---------------------------------------------------------
        let toastTimeout;
        function showToast(title, msg, type = 'error') {
            const box = document.getElementById('toast-box');
            const content = document.getElementById('toast-content');
            const icon = document.getElementById('toast-icon');
            document.getElementById('toast-title').textContent = title;
            document.getElementById('toast-msg').textContent = msg;

            content.className = "px-5 py-4 rounded-2xl shadow-2xl border-2 border-white flex items-start gap-3 text-white ";
            if (type === 'error') {
                content.classList.add('bg-rose-600');
                icon.textContent = '🚫';
                playErrorSound();
            } else if (type === 'success') {
                content.classList.add('bg-emerald-600');
                icon.textContent = '🎉';
                playSuccessSound();
            } else {
                content.classList.add('bg-amber-600');
                icon.textContent = '💡';
                playClickSound();
            }

            box.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(hideToast, 4500);
        }

        function hideToast() {
            document.getElementById('toast-box').classList.add('hidden');
        }

        // ---------------------------------------------------------
        // 4. NAVIGASI HALAMAN NON-LINEAR (Revisi Poin 7 & 8)
        // ---------------------------------------------------------
        function startApp() {
            playSuccessSound();
            document.getElementById('view-splash').classList.add('hidden');
            document.getElementById('main-header').classList.remove('hidden');
            // Setelah layar pembuka, arahkan ke halaman Petunjuk Penggunaan & Tujuan Pembelajaran (Revisi Poin 7)
            navigateTo('guide');
        }

        function navigateTo(viewName) {
            playClickSound();
            const views = ['splash', 'guide', 'menu', 'materi', 'kasir', 'kuis'];
            views.forEach(v => {
                const el = document.getElementById('view-' + v);
                if (el) el.classList.add('hidden');
            });
            document.getElementById('view-' + viewName).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ---------------------------------------------------------
        // 5. LOGIKA MATERI & LATIHAN BERTAHAP (Revisi Poin 10 & 13)
        // ---------------------------------------------------------
        const contohBilanganData = [
