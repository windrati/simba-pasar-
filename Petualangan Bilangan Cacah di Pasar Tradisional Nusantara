        function getRawCartTotal() {
            return cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
        }

        function getFinalCartTotal() {
            return Math.max(0, getRawCartTotal() - bargainDiscount);
        }

        // REVISI POIN 1: Batasi total belanja maksimal Rp99.999 (tolak barang yang melebihi batas dan beri pesan)
        function addToCart(productId) {
            const prod = marketProducts.find(p => p.id === productId);
            if (!prod) return;

            const currentTotal = getFinalCartTotal();
            if (currentTotal + prod.price > 99999) {
                showToast(
                    "Batas Belanja Maksimal Rp99.999!",
                    Menambah ${prod.name} (${formatRupiah(prod.price)}) akan membuat total belanja menjadi ${formatRupiah(currentTotal + prod.price)} (melebihi 5 digit / Rp99.999). Silakan pilih barang lain yang lebih murah atau selesaikan transaksi ini.,
                    "error"
                );
                return;
            }

            playClickSound();
            const existing = cart.find(i => i.id === productId);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...prod, qty: 1 });
            }

            // Reset diskon tawar menawar jika keranjang berubah
            bargainDiscount = 0;
            generateVariedBuyerCash(getFinalCartTotal());
            renderCart();
        }

        function removeFromCart(productId) {
            playClickSound();
            const idx = cart.findIndex(i => i.id === productId);
            if (idx > -1) {
                if (cart[idx].qty > 1) {
                    cart[idx].qty -= 1;
                } else {
                    cart.splice(idx, 1);
                }
            }
            bargainDiscount = 0;
            generateVariedBuyerCash(getFinalCartTotal());
            renderCart();
        }

        function resetKasirCart() {
            playClickSound();
            cart = [];
            bargainDiscount = 0;
            buyerCash = 0;
            buyerCashNotes = [];
            ['nt-pr', 'nt-r', 'nt-rt', 'nt-p', 'nt-s', 'change-input'].forEach(id => {
                document.getElementById(id).value = '';
            });
            renderCart();
        }

