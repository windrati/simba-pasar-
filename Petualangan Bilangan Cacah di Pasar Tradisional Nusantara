        function applyBargain() {
            const rawTotal = getRawCartTotal();
            if (rawTotal < 10000) {
                showToast("Belum Bisa Ditawar", "Belanja minimal Rp10.000 dulu ya untuk melakukan tawar-menawar dengan pedagang!", "info");
                return;
            }
            if (bargainDiscount > 0) {
                showToast("Sudah Ditawar", "Harga keranjang ini sudah mendapat potongan kesepakatan tawar-menawar!", "info");
                return;
            }

            // Potongan tawar-menawar acak yang realistis (Rp1.000, Rp1.500, Rp2.000, atau Rp2.500)
            const discounts = [1000, 1500, 2000, 2500];
            bargainDiscount = discounts[Math.floor(Math.random() * discounts.length)];
            
            showToast(
                "Tawar-Menawar Berhasil! 🤝",
                Pedagang setuju memberi potongan harga sebesar ${formatRupiah(bargainDiscount)}!,
                "success"
            );
            generateVariedBuyerCash(getFinalCartTotal());
            renderCart();
        }

